# Copy to .env and fill in. `.env` is gitignored - never commit it.
#
# DATABASE_URL must be a full JDBC URL and is used exactly as written: the `jdbc:` prefix
# is required and is not added for you. Credentials are not read from the URL - put the
# host and database here and the user/password in DATABASE_USER and DATABASE_PASSWORD
# below (keeping them out of the URL stops connection errors from printing the password).
# Use the pooled string (hostname ending in `-pooler`) for the running server.
DATABASE_URL=jdbc:postgresql://HOST/neondb?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=PT12H
JWT_REFRESH_EXPIRES_IN=P30D
CORS_ALLOWED_ORIGINS=http://localhost:4321
SERVER_PORT=8080
