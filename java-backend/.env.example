# Copy to .env and fill in. `.env` is gitignored - never commit it.
#
# The connection string from console.neon.tech works as-is: it is quoted, the `jdbc:`
# prefix is added for you, and the `user:password@` part is ignored in favour of
# DATABASE_USER and DATABASE_PASSWORD below (keeping it out of the URL stops connection
# errors from printing the password). Use the pooled string (hostname ending in
# `-pooler`) for the running server.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=PT12H
JWT_REFRESH_EXPIRES_IN=P30D
CORS_ALLOWED_ORIGINS=http://localhost:4321
SERVER_PORT=8080
