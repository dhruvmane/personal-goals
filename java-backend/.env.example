# Copy to `.env` and fill in real values. `.env` is gitignored - never commit secrets.
# Get these from the Neon Console: https://console.neon.tech
# Use the "-pooler" hostname for the pooled connection string (better for a server), or
# the direct hostname for migrations. Both work with this setup.

DATABASE_URL=jdbc:postgresql://ep-cool-name-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=replace-me

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars-long
# Token lifetime as a duration (PT12H = 12 hours)
JWT_EXPIRES_IN=PT12H

# Where the Astro frontend is served. Comma-separated for multiple origins.
CORS_ALLOWED_ORIGINS=http://localhost:4321

SERVER_PORT=8080
