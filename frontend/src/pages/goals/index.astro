---
import Layout from '../../layouts/Layout.astro'
import GoalDashboard from '../../components/PAGE/GOALS/GoalDashboard.svelte'
import Clock from '../../components/UI/Clock.svelte'
---

<Layout title="Your goals, goalden">
    <div class="w-full px-4 py-5 sm:px-6 lg:px-10">

        <!-- DASHBOARD HEADER -->
        <header class="py-3 modern-border flex flex-wrap items-center gap-3 px-5">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl mr-auto">
                Your <span class="text-secondary">Goals</span>
            </h1>
            <p class="hidden md:block text-sm opacity-50">Create, track and clear what matters.</p>
            <div class="text-2xl lg:text-3xl tabular-nums opacity-80">
                <Clock client:load />
            </div>
        </header>

        <GoalDashboard client:load />

    </div>
</Layout>
