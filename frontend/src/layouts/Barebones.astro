---
// The Main Layout of Everything in the APP

// import css for tailwind on whole page
import "../styles/global.css";

// components
import Nav from '../components/PAGE/Nav.astro'
import Foo from '../components/PAGE/Foo.astro'

// title prop for changing page title
const { title = "goals.io" } = Astro.props
---


<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="relative">
	    <div class="page">
	        <Nav showLogo={false} />
		    <slot />
		</div>
		<div class="foo">
		    <Foo />
		</div>
	</body>
</html>
